功名意懶","苫茅屋白雲數間","睡芸窗紅日三竿","遠近村","高低澗","把人我是非遮斷","閬苑蓬萊咫尺間","因此上功名意懶","萬言策長沙不還","六韜書雲夢空嘆","只為他進身的疾","收心的晚","終不免有許多憂患","見了些無下梢從前玉筍班","因此上功名意懶","筆硯琴書座間","松筠梅菊江干","歡有餘","春無限","綽然亭只疑在天上","萬事無心一釣竿","因此上功名意懶","寄閲世道人侯和卿披一領熬日月耐風霜道袍","系一條鎖心猿拴意馬環絛","穿一對聖僧鞋","帶一頂温公帽","一心敬奉三教","休指望做神仙上九霄","只落得無是非清閒到老"],"","","",""],["open-yuanqu-d48636342f81a32a5023",["我為你受跋涉","我為你遭磨折","丈夫","我為你投江","我為你把殘生舍","今日怎知先傾逝","這樣淒涼．教我暗地裏和誰説","稟爹爹","可容奴家帶孝","(外)兒","在任穿些素縞吧","(旦)與我除下釵梳","盡把羅衣卸","持喪素服存貞沾"],"","","",""],["open-yuanqu-2bbf4095d26d2f4aa8ae",["(生)一從科第鳳鸞飛","被奸謀有書空寄","幸萱堂無禍危","痛蘭房受岑寂","捱不過凌逼","身沈在浪濤裏"],"","","",""],["open-yuanqu-fab565af4bcc30ec90ca",["思量悶上心","人去無蹤影","悄似隨風柳絮無憑準","卻與舊日心不應","誤我良宵寂寞守孤燈","數盡更籌夜長人初靜","教人恨殺活短命"],"","","",""],["open-yuanqu-e0d568dce4f8704a05dd",["哥哥毒害","是我前生結債","他將我萬種凌辱","這苦何日得泰","我願丈夫","丈夫榮歸故里","稱奴心意告神祗","願得兒夫至","還鄉衣錦歸"],"","","",""],["open-yuanqu-2771cebba7fe582bac57",["課","茶飯上減了飲食","針指上罷了心機","怎對人言説這就裏"],"","","",""],["open-yuanqu-1a0866609d23e00072e0",["俺小姐這一個有千般嬌態","新狀元有萬種襟懷","荷皇恩榮升寵齎","成配偶不勝感戴","端的個美哉","壯哉","這都是聖裁","（院公上雲）喏","報的夫人、狀元知道","有天朝使命到了","（白敏中雲）快排香案","接待天使","（正旦唱）願萬萬載民安國泰","（李尚書上","雲）小官李絳","奉聖人的命","到晉國公宅上","成合這門親事","加官賜賞","走一遭去","可早來到也","白敏中","你一家兒望闕跪着","聽聖人的命：只為你父參軍","曾救裴晉公之難","許小蠻為妻","以報大恩","今日敏中登科及第","成就此親","官封三代","裴夫人賜金千兩","你聽者：（詞雲）晉國公開勳臣","遺玉帶許結婚姻","白敏中果登雲路","奉聖命匹配成親","賜小蠻鳳冠霞帔","賜夫人萬兩金銀","今日個加官賜賞","一家門共戴天恩"],"","","",""],["open-yuanqu-e0953c713f571bb942aa",["我嘆這個老員外","積趲下些不義財","俺男兒的受了宣牌","媳婦兒的有些人才","百姓每恭心管待","那其間誰齎發呂秀才"],"","","",""],["open-yuanqu-41cbdb1c84e220d34dec",["俺可也虛度春秋","強捱昏晝","空生受","肥馬輕裘","為甚事擔消瘦"],"","","",""],["open-yuanqu-e5b756b33eaee2d4511f",["我只道你殺人刀十分的利害","元來這活人心依然尚在","便做道俺兩個該死的遊魂甚耽待","也則是可憐見白頭奶奶"],"","","",""],["open-yuanqu-510d7c535d28b1ae5ef3",["我如今樂矣忘憂","暮年衰朽","甘生受","虛度了春秋","每日家詩酒消白晝"],"","","",""],["open-yuanqu-cdf3f08ef2abaee36fe5",["駕一片妖雲","引半垓厲鬼","則為子母情腸","惡了那神佛麪皮","則着你缽盂中抄化檀那","誰教你法座下傷人家小的","我和你","是誰非","拿住呵恰便似二鬼爭環","休想有九龍噴水"],"","","",""],["open-yuanqu-74296d07bcbea13d96fb",["氣的來有眼如盲、有口似啞","您兩個綠鬢朱顏","也合問您這蒼髯皓髮","不爭你背母拋爹","直閃