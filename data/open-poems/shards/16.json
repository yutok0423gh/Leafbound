理"],"","","",""],["open-yuanqu-407dd343cc3fa2b2f7a4",["(生)停威息怒","聽小人從頭稟覆","新充小軍當差使","焉敢盜取衣袂","昨夜三更巡警過","忽見紫袍空中聽","料莫是天宮賜我","料莫是天宮賜我"],"","","",""],["open-yuanqu-9b7a249e2373813611e7",["(旦)從伊去後受禁持","不從改嫁生惡意","因此骨肉參商","罰奴磨麥並挑水","止望你","身顯跡","又誰知","恁狼狽"],"","","",""],["open-yuanqu-a4b04fba9a52ed7e5d62",["地","要祭賽的窮神下的呵吃","村居人性善皆由天命","氣清濁列等為賢聖","萬物內最為靈","又幸為男子崢嶸","要自省","妍媸貴賤","壽夭窮通","這幾事皆前定","使不着吾強我性","嘆時乖運拙","隨坎止流行","既知鐘鼎果無緣","好向林泉且埋名","除去浮花","修養殘軀","安排暮景"],"","","",""],["open-yuanqu-bf381807fa6b2ee2eca2",["非是俺三軍費苦勞","謝叔父一計真奇妙","因此上八方定虜番","卻原來叫海除兇暴","(桓衝雲)今日個邊庭寧靜","掃蕩西秦","八方無事","萬萬載太平之世也","(正末唱)"],"","","",""],["open-yuanqu-1c7bbcba557fb2f787cd",["江景蕭疏","那堪楚天秋暮","戰西風柳敗荷枯","立夕陽","空凝佇","江鄉古渡","水接天隅","眼瀰漫晚山煙樹"],"","","",""],["open-yuanqu-2a0db20d04ce0780543b",["諸佛眾神多謙讓","全在吾師做主張","保金經福無量","向花果山中再相訪"],"","","",""],["open-yuanqu-95ab007ceda7e1c7efeb",["引元神赴宮殿","妙用三關機變","一氣來透徹三田","九轉爐中煙焰","龍虎龜蛇蟠旋","出於自然","自然","有一個無為真人出現"],"","","",""],["open-yuanqu-96786739978abe1692a0",["飄蓬","嘆青春湖海西東","幾番家惱人愁越重","一聲聲風送簾櫳","猿啼峻嶺","雁過南樓","鶴唳高松"],"","","",""],["open-nalan-d438367664f5c9cf3f8f",["別緒如絲夢不成","那堪孤枕夢邊城","因聽紫塞三更雨","卻憶紅樓半夜燈","書鄭重","恨分明","天將愁味釀多情","起來呵手封題處","偏到鴛鴦兩字冰"],"","","",""],["open-nalan-6c28812812d04b150c6d",["何處幾葉蕭蕭雨","濕盡檐花","花底人無語","掩屏山","玉爐寒","誰見兩眉愁聚倚闌干"],"","","",""]]}
