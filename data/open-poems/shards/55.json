6a41247f1eb2",["親鞠養","我爹爹呵","擇良人求配鴛行","誰知道命合遭殃","命合遭殃","遞讒書逼奴險亡","蒙天眷","遇賢良","奴家燒此夜香呵","保佑他永安康","保佑他永安康","想我婆婆取奴家呵"],"","","",""],["open-yuanqu-72293b83dbd283bf4010",["都吃得醉如泥"],"","","",""],["open-yuanqu-47ed1f3481a227d600bc",["亂到更闌人靜"],"","","",""],["open-yuanqu-1487143e391796e9c422",["眼兒前不甫能栽起合歡樹","恨不得手掌裏奇擎着解語花","盡今生翠鸞同跨","怎生般愛他看待他","怎下的教橫拖在馬嵬坡下"],"","","",""],["open-yuanqu-c2a2f380a90f3ab4f215",["哎喲","正值着這冬寒天色","破瓦窯中又無些米柴","眼見的凍死屍骸","料沒個人瞅睬","誰肯着半掀兒家土埋","老業人眼見的便撇在這荒郊外","(雜當上","雲)兀的那老兩口兒","比及你在這裏叫化","相國寺裏散齋哩","你那裏求一齋去不好那","(正末雲)多謝哥哥","元來相國寺裏散齋","婆婆","去來","去來","(卜兒雲)老的也","俺往那裏叫化去","(正末唱)"],"","","",""],["open-yuanqu-2d13443ee19231f9cc0c",["我想着那當初一日","(二旦雲)可不道金榜無名誓不歸","(正末雲)蘇秦也","你料着不得官呵","休説那般大言波","(唱)你再休説道是金榜無名誓不歸","(二旦雲)你這些時在那裏那","(正末唱)我在那弘農縣裏","(二旦雲)在那裏做些甚麼","(正末唱)無靠無依","任受盡多狼狽","罷、罷、罷","我男子漢身長七尺","寧死也做一個不着家鄉的鬼"],"","","",""]]}
